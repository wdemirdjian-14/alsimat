# =====================================================================
#  Site Alsimat - variables d'environnement
#  Copier ce fichier en ".env" puis remplacer chaque <A_RENSEIGNER>.
#  Ne JAMAIS publier le fichier .env (il contient des secrets).
# =====================================================================

# --- Base de données (obligatoire) -----------------------------------
# Chaîne de connexion PostgreSQL utilisée par Prisma.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE?schema=public
DATABASE_URL="<A_RENSEIGNER>"

# --- Authentification de l'espace admin (obligatoire) ----------------
# Clé secrète aléatoire servant à signer les sessions (JWT) NextAuth.
# Générer par ex. avec : openssl rand -base64 32
NEXTAUTH_SECRET="<A_RENSEIGNER>"
# URL publique du site (sans "/" final), ex. https://www.alsimat.fr
# En local : http://localhost:3000
NEXTAUTH_URL="<A_RENSEIGNER>"

# --- Stockage des images (S3 ou compatible S3) -----------------------
# Nécessaire pour les nouveaux uploads (admin + photos du formulaire SAV).
# Région du bucket, ex. eu-west-3 (Paris) pour AWS.
AWS_REGION="<A_RENSEIGNER>"
# Nom du bucket.
AWS_BUCKET_NAME="<A_RENSEIGNER>"
# Préfixe (dossier) ajouté devant chaque fichier, ex. "alsimat/" (peut rester vide).
AWS_FOLDER_PREFIX="<A_RENSEIGNER>"
# Identifiants d'accès (utilisateur IAM avec droits PutObject/GetObject/DeleteObject sur le bucket).
# Facultatifs si l'hébergeur fournit les identifiants autrement (rôle IAM, AWS_PROFILE...).
AWS_ACCESS_KEY_ID="<A_RENSEIGNER>"
AWS_SECRET_ACCESS_KEY="<A_RENSEIGNER>"
# Facultatif : profil AWS local (~/.aws/credentials) à utiliser à la place des clés ci-dessus.
# AWS_PROFILE="<A_RENSEIGNER>"
# Facultatif : endpoint d'un service compatible S3 (Scaleway, OVH, Cloudflare R2, MinIO...).
# Laisser vide pour AWS S3.
# AWS_S3_ENDPOINT="<A_RENSEIGNER>"
# Facultatif : "true" pour l'adressage en chemin (souvent requis par MinIO).
# AWS_S3_FORCE_PATH_STYLE="<A_RENSEIGNER>"
# Facultatif : URL publique de base des fichiers (CDN ou domaine du bucket),
# ex. https://cdn.alsimat.fr  — sinon l'URL standard AWS S3 est utilisée.
# AWS_PUBLIC_BASE_URL="<A_RENSEIGNER>"

# --- Gestion des comptes administrateurs (facultatif) ----------------
# Utilisées par "yarn create-admin" (et par le script de seed) pour créer
# ou réinitialiser un compte admin. Retirer le mot de passe du .env ensuite.
# ADMIN_EMAIL="<A_RENSEIGNER>"
# ADMIN_PASSWORD="<A_RENSEIGNER>"
# ADMIN_NAME="<A_RENSEIGNER>"
# "true" pour autoriser temporairement la route POST /api/signup
# (création d'un compte admin). Laisser à "false" en production.
ALLOW_ADMIN_SIGNUP="false"

# --- Build (facultatif, avancé) --------------------------------------
# "standalone" pour produire un serveur autonome (Docker/VPS). Vide par défaut.
# NEXT_OUTPUT_MODE="<A_RENSEIGNER>"
# Dossier de build Next.js (par défaut ".next").
# NEXT_DIST_DIR="<A_RENSEIGNER>"
