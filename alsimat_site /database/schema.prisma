generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  order       Int      @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicles    VehicleCategory[]
}

model Vehicle {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  shortDescription String?
  price           String?
  characteristics Json?    @default("{}")
  images          String[] @default([])
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  categories      VehicleCategory[]
}

model VehicleCategory {
  vehicleId  String
  categoryId String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vehicleId, categoryId])
}

model SavTicket {
  id           String   @id @default(cuid())
  serialNumber String
  firstName    String
  lastName     String
  email        String
  phone        String
  description  String
  files        String[] @default([])
  status       String   @default("Nouveau")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  date        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  role           String   @default("admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  description String?
  image       String?
  discount    String?
  badge       String?
  ctaLabel    String?
  ctaLink     String?
  active      Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UsedVehicle {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  price           String?
  year            String?
  mileage         String?
  condition       String?
  characteristics Json?    @default("{}")
  images          String[] @default([])
  sold            Boolean  @default(false)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ConfiguratorModel {
  id        String        @id @default(cuid())
  name      String
  subtitle  String?
  basePrice Float         @default(0)
  image     String?
  order     Int           @default(0)
  active    Boolean       @default(true)
  groups    ConfigGroup[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ConfigGroup {
  id       String            @id @default(cuid())
  modelId  String
  model    ConfiguratorModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name     String
  subtitle String?
  required Boolean           @default(false)
  order    Int               @default(0)
  options  ConfigOption[]
}

model ConfigOption {
  id          String      @id @default(cuid())
  groupId     String
  group       ConfigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceDelta  Float       @default(0)
  order       Int         @default(0)
}

model QuoteRequest {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  message     String?
  source      String?
  vehicleRef  String?
  config      Json?
  totalHt     Float?
  status      String   @default("Nouveau")
  createdAt   DateTime @default(now())
}
