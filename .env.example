# ======== Copier en .env puis compléter (ne jamais committer .env) ========

# URL publique du site (sans / final) — sert aux balises canoniques, au sitemap et aux e-mails
SITE_URL=https://alsimat.com

# Mot de passe de la base PostgreSQL (docker compose) — générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé de signature des sessions admin — générer avec : openssl rand -base64 48
AUTH_SECRET=

# Port local de l'application (doit être libre sur le VPS ; Nginx redirige vers lui)
APP_PORT=3010

# ---- E-mails (notifications des demandes) — SMTP IONOS ----
# Créez une boîte (ex. site@alsimat.com) dans l'espace IONOS, puis :
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Alsimat <site@alsimat.com>"
# Destinataire des notifications (par défaut : e-mail de contact défini dans l'admin)
NOTIFY_EMAIL=

# Mettre à false sur un site de préproduction pour interdire l'indexation Google
ALLOW_INDEXING=true

# ---- Développement local uniquement ----
# DATABASE_URL=postgresql://alsimat:alsimat@localhost:5432/alsimat
# UPLOAD_DIR=./uploads
