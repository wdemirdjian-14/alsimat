generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  intro          String?           @db.Text
  image          String?
  order          Int               @default(0)
  published      Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  parent         Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryHierarchy")
  vehicles       VehicleCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Vehicle {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  shortDescription String?           @db.Text
  description      String?           @db.Text
  price            String?
  characteristics  Json              @default("{}")
  images           String[]          @default([])
  featured         Boolean           @default(false)
  published        Boolean           @default(true)
  order            Int               @default(0)
  seoTitle         String?
  seoDescription   String?
  /// Mise en avant « vitrine » : page produit enrichie + bloc sur l'accueil
  spotlight        Boolean           @default(false)
  /// Marque constructeur (ex. « Little ») et type affiché (ex. « Utilitaire électrique »)
  brand            String?
  vehicleType      String?
  /// Stock disponible immédiatement (0 = sur commande) et offre promotionnelle éventuelle
  stock            Int               @default(0)
  promoPrice       String?
  promoLabel       String?
  promoEndsAt      DateTime?
  tagline          String?
  sku              String?
  video            String?
  datasheet        String?
  equipment        String?           @db.Text
  colors           String[]          @default([])
  upholstery       String[]          @default([])
  categories       VehicleCategory[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model VehicleCategory {
  vehicleId  String
  categoryId String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vehicleId, categoryId])
}

model UsedVehicle {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  price           String?
  year            String?
  mileage         String?
  condition       String?
  characteristics Json     @default("{}")
  images          String[] @default([])
  sold            Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  image       String?
  discount    String?
  badge       String?
  ctaLabel    String?
  ctaLink     String?
  active      Boolean   @default(true)
  endsAt      DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Réalisations clients
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  location    String?
  date        String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Articles « Conseils » (blog)
model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?   @db.Text
  content        String    @db.Text
  image          String?
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Demandes entrantes : devis, contact, SAV
model Inquiry {
  id           String   @id @default(cuid())
  type         String // "devis" | "contact" | "sav"
  firstName    String
  lastName     String
  company      String?
  email        String
  phone        String?
  postalCode   String?
  subject      String?
  message      String?  @db.Text
  vehicleRef   String?
  serialNumber String?
  /// Provenance du contact (campagne, réseau, référencement…)
  source       String?
  files        String[] @default([])
  status       String   @default("nouveau") // nouveau | en_cours | traite | archive
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  role           String   @default("admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ======================= CRM =======================

/// Contact (prospect, client, partenaire) — alimenté par les formulaires du site, l'import CSV ou la saisie.
model Contact {
  id             String              @id @default(cuid())
  email          String              @unique
  firstName      String?
  lastName       String?
  company        String?
  jobTitle       String?
  phone          String?
  city           String?
  postalCode     String?
  website        String?
  segment        String              @default("prospect") // prospect | client | partenaire
  status         String              @default("nouveau") // voir lib/crm.ts
  tags           String[]            @default([])
  source         String?
  /// Base légale : "b2b" (intérêt légitime pro) | "optin" (accord explicite) | "client"
  consent        String              @default("b2b")
  originNote     String?
  notes          String?             @db.Text
  estimatedValue Int?
  unsubscribed   Boolean             @default(false)
  unsubscribedAt DateTime?
  bounced        Boolean             @default(false)
  lastContactAt  DateTime?
  activities     Activity[]
  inquiries      Inquiry[]
  recipients     CampaignRecipient[]
  lists          ListMember[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([segment])
}

/// Liste de diffusion (ex. « Campings France », « Mairies Loiret », « Salon 2026 »).
model ContactList {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  color       String       @default("#46a584")
  members     ListMember[]
  createdAt   DateTime     @default(now())
}

model ListMember {
  listId    String
  contactId String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@id([listId, contactId])
  @@index([contactId])
}

/// Historique d'un contact : notes, appels, e-mails, demandes, campagnes.
model Activity {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String // note | appel | email | demande | campagne | statut | rdv
  title     String
  content   String?  @db.Text
  author    String?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

/// Campagne e-mail de prospection / information.
model Campaign {
  id          String              @id @default(cuid())
  name        String
  subject     String
  preheader   String?
  body        String              @db.Text
  ctaLabel    String?
  ctaUrl      String?
  image       String?
  /// Filtre des destinataires : { segments: [], statuses: [], tags: [], excludeTags: [] }
  audience    Json                @default("{}")
  status      String              @default("brouillon") // brouillon | programmee | envoi | envoyee | pause
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  recipients  CampaignRecipient[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  token      String    @unique @default(cuid())
  status     String    @default("attente") // attente | envoye | echec | ignore
  error      String?
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  clicks     Int       @default(0)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

/// Redirections 301 gérées depuis l'admin (anciennes URL, pages supprimées…).
model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}
