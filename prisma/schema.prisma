generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  intro          String?           @db.Text
  image          String?
  order          Int               @default(0)
  published      Boolean           @default(true)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  parent         Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryHierarchy")
  vehicles       VehicleCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Vehicle {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  shortDescription String?           @db.Text
  description      String?           @db.Text
  price            String?
  characteristics  Json              @default("{}")
  images           String[]          @default([])
  featured         Boolean           @default(false)
  published        Boolean           @default(true)
  order            Int               @default(0)
  seoTitle         String?
  seoDescription   String?
  categories       VehicleCategory[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model VehicleCategory {
  vehicleId  String
  categoryId String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vehicleId, categoryId])
}

model UsedVehicle {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  price           String?
  year            String?
  mileage         String?
  condition       String?
  characteristics Json     @default("{}")
  images          String[] @default([])
  sold            Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  image       String?
  discount    String?
  badge       String?
  ctaLabel    String?
  ctaLink     String?
  active      Boolean   @default(true)
  endsAt      DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Réalisations clients
model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  location    String?
  date        String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Articles « Conseils » (blog)
model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?   @db.Text
  content        String    @db.Text
  image          String?
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Demandes entrantes : devis, contact, SAV
model Inquiry {
  id           String   @id @default(cuid())
  type         String // "devis" | "contact" | "sav"
  firstName    String
  lastName     String
  company      String?
  email        String
  phone        String?
  postalCode   String?
  subject      String?
  message      String?  @db.Text
  vehicleRef   String?
  serialNumber String?
  files        String[] @default([])
  status       String   @default("nouveau") // nouveau | en_cours | traite | archive
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  role           String   @default("admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
